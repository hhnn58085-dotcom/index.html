# Add JS for geographic mapping before update().
js_insert = r'''
const gazaZones={
 north:{name:'شمال غزة',x:'44%',y:'15%',scene:'hospital',time:8},
 gaza:{name:'مدينة غزة',x:'48%',y:'32%',scene:'market',time:6},
 central:{name:'المنطقة الوسطى',x:'47%',y:'50%',scene:'station',time:8},
 khan:{name:'خان يونس',x:'49%',y:'69%',scene:'park',time:10},
 rafah:{name:'رفح',x:'51%',y:'88%',scene:'oldtown',time:12}
};
let mapScale=1;
function gazaVisit(zone){
  const z=gazaZones[zone]; if(!z)return;
  move(zone==='north'?'hospital':zone==='gaza'?'market':zone==='central'?'station':zone==='khan'?'park':'oldtown');
  advance(z.time,'انتقلت إلى '+z.name);
  log('📍 وصلت إلى '+z.name+'.');
  showModal(`<h1>📍 ${z.name}</h1><p class="muted">منطقة من خريطة غزة داخل عالم اللعبة. المواقع والأحداث والمهام هنا خيالية ومصممة للعبة.</p>
  <button class="choice" onclick="gazaPOI('${z.scene}')">استكشاف المنطقة</button>
  <button class="choice" onclick="closeModal()">إغلاق</button>`);
}
function gazaPOI(p){visit(p)}
function mapZoom(f){
  mapScale=Math.max(.75,Math.min(1.55,mapScale*f));
  document.querySelector('.gaza-svg').style.transform=`scale(${mapScale})`;
}
function mapReset(){mapScale=1;document.querySelector('.gaza-svg').style.transform='scale(1)'}
'''
